@if (Open)
{
    <div class="overlay-root" @onclick="OnBackdrop">
        <div class="overlay-card @(Wide ? "overlay-card-wide" : "")" @onclick:stopPropagation>
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task OnBackdrop()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
